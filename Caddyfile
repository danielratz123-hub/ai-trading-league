# Caddy: the only thing reachable from the internet (ports 80 and 443).
# It gets and renews a Let's Encrypt certificate for DOMAIN automatically,
# redirects http -> https, and passes requests to the app on the internal
# Docker network. DOMAIN comes from .env.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Search engines: stay out (the app also sends noindex on every page).
	respond /robots.txt <<TXT
		User-agent: *
		Disallow: /
		TXT 200

	# Agent Hub (docker compose profile "hub", see HUB.md): only for a
	# signed-in browser. Caddy asks the dashboard's /auth/check first; when
	# the hub isn't running, /hub just answers 502 and nothing else changes.
	@hub path /hub /hub/*
	handle @hub {
		forward_auth api:8000 {
			uri /auth/check
		}
		reverse_proxy hub:8100
	}

	# Admin site (compose profile "admin"): same login as the hub, read-only.
	@admin path /admin /admin/*
	handle @admin {
		forward_auth api:8000 {
			uri /auth/check
		}
		reverse_proxy admin:8200
	}

	handle {
		# Overwrite whatever X-Forwarded-For a visitor sends, so the login rate
		# limit sees the real address.
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	log {
		output stdout
		format console
	}
}
