# Copy this file to .env and fill in your keys. .env is git-ignored.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# cli = run agents via Claude Code / Codex on your subscriptions (no API keys needed)
# api = pay-per-token APIs (then also set ANTHROPIC_API_KEY / OPENAI_API_KEY)
AGENT_BACKEND=cli
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Models (both agents must use the same REASONING_EFFORT for fairness).
# Leave GPT_MODEL empty to use your ChatGPT plan's default Codex model.
CLAUDE_MODEL=claude-opus-5-5
GPT_MODEL=
REASONING_EFFORT=medium

# api backend only: USD per million tokens for your GPT model (check OpenAI's pricing page)
GPT_PRICE_IN=1.25
GPT_PRICE_CACHED_IN=0.125
GPT_PRICE_OUT=10.00

# api backend only: research budget per agent per week
MAX_API_SPEND_USD=1.0

# ALPACA_DATA_FEED=sip

# Dashboard: token for the Admin pause/resume button (pick any long random string)
ADMIN_TOKEN=
# Allowed origins if the dashboard is hosted elsewhere (e.g. Vercel), comma-separated
# DASHBOARD_ORIGINS=https://your-dashboard.vercel.app

# Deployment (see DEPLOY.md)
# CLAUDE_CODE_OAUTH_TOKEN=     # from `claude setup-token` (for servers / Docker)
# CODEX_SANDBOX=read-only      # danger-full-access if Codex's sandbox fails inside Docker
# DOMAIN=league.example.com    # for HTTPS with Caddy
# MIRROR_PAPER=0  (older setting, replaced by MIRROR_MODE)

# Alpaca paper mirror (Setup step 6): off | leader | each
MIRROR_MODE=off
# ChatGPT's own paper account (a second paper account), for MIRROR_MODE=each
# ALPACA_MIRROR_GPT_KEY=
# ALPACA_MIRROR_GPT_SECRET=
# Claude's own paper account (optional; defaults to ALPACA_API_KEY / ALPACA_SECRET_KEY)
# ALPACA_MIRROR_CLAUDE_KEY=
# ALPACA_MIRROR_CLAUDE_SECRET=
