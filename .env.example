# AI Trading League settings.
# Copy this file to .env and fill it in:   cp .env.example .env && nano .env
# .env is never committed to git and never sent to the agents.
# Lines starting with # are comments. No quotes and no spaces around "=".
#
# Docker Compose reads this file too. In Compose a "$" starts a variable, so
# any "$" inside a value must be written as "$$" (hash-password does this
# for you).

# ---------------------------------------------------------------------------
# Market data and trading (Alpaca, free plan is enough)
# https://app.alpaca.markets -> Paper account -> API Keys
# ---------------------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Price data feed: iex (free plan) or sip (paid "Algo Trader Plus", all US
# exchanges). Change it here when you upgrade; no code changes needed.
ALPACA_DATA_FEED=iex

# ---------------------------------------------------------------------------
# The agents
# ---------------------------------------------------------------------------
# cli = Claude Code / Codex on your subscriptions (no API bills)
# api = pay-per-token APIs (then also set ANTHROPIC_API_KEY / OPENAI_API_KEY)
AGENT_BACKEND=cli
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Models. Both agents use the same REASONING_EFFORT (low | medium | high) for
# fairness. GPT_MODEL empty = your ChatGPT plan's default Codex model.
CLAUDE_MODEL=claude-opus-5-5
GPT_MODEL=
REASONING_EFFORT=medium

# Claude Code login on a server: run `claude setup-token` on your PC and
# paste the sk-ant-oat01-... token here. Only Claude Code receives it.
# (Codex signs in with `codex login --device-auth`; see DEPLOY.md.)
CLAUDE_CODE_OAUTH_TOKEN=

# Codex's own sandbox: read-only (default). Only if DEPLOY.md's check says
# Codex's sandbox can't start inside Docker, use danger-full-access: Codex's
# shell tool is switched off anyway, so the container is the boundary.
# CODEX_SANDBOX=read-only

# Web searches per agent per weekly turn: a soft limit written into the
# briefing (both agents get the same number). The dashboard shows the
# actual counts side by side.
WEB_SEARCH_SOFT_LIMIT=15

# Telegram alert when an agent's ESTIMATED AI cost for one day (tokens priced
# at API rates) goes above this. Only an alert: agents are never paused.
DAILY_AI_COST_ALERT_USD=20

# Weekly strategy reports (written by each agent after a week is scored).
# REPORTS=1
# REPORT_TIMEOUT_SEC=600
# REPORT_MAX_TOOL_CALLS=8

# api backend only: USD per million tokens for your GPT model, and the
# research budget per agent per week.
GPT_PRICE_IN=1.25
GPT_PRICE_CACHED_IN=0.125
GPT_PRICE_OUT=10.00
MAX_API_SPEND_USD=1.0

# ---------------------------------------------------------------------------
# Website (server)
# ---------------------------------------------------------------------------
# Your domain for the dashboard. Its DNS A record must point at the server.
# Caddy gets the HTTPS certificate automatically.
DOMAIN=league.example.com

# Dashboard password, stored only as a hash. Make the line with:
#   docker compose run --rm api python -m arena.main hash-password
# (on the PC: .venv\Scripts\python -m arena.main hash-password)
# Required on the server. On your PC the login is off while this is empty.
DASHBOARD_PASSWORD_HASH=

# Admin token: needed for the dashboard's pause/resume and to sign login
# sessions. Required on the server, at least 32 characters. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# or: openssl rand -base64 32
# Changing it (or the password) signs every browser out.
ADMIN_TOKEN=

# Your user id on the server (run: id -u). The containers run as this user,
# so the setup page can save settings into this file while it stays private.
APP_UID=1000

# ---------------------------------------------------------------------------
# Alerts (Telegram). See DEPLOY.md "Alerts" for how to get both values.
# Empty = alerts only go to the log.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Backups to Google Drive (or any rclone remote). Set up once with rclone
# (DEPLOY.md "Backups"), then e.g. BACKUP_RCLONE_REMOTE=gdrive:ai-trading-league
# When set, it's used instead of the S3 settings below.
BACKUP_RCLONE_REMOTE=

# ---------------------------------------------------------------------------
# Backups: any S3-compatible storage (Backblaze B2, Wasabi, AWS S3, ...).
# B2: Buckets -> Create a Bucket (private); Application Keys -> Add a New
# Application Key limited to that bucket. The endpoint is shown on the
# bucket page, e.g. https://s3.us-west-004.backblazeb2.com
# Empty = backups are only kept on the server (data/backups), which does
# NOT protect against losing the server.
# ---------------------------------------------------------------------------
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=arena/
BACKUP_KEEP_DAILY=30
# Monthly copies on top of the daily ones (0 = none, just the last 30 days).
BACKUP_KEEP_MONTHLY=12

# ---------------------------------------------------------------------------
# Outside monitoring (DEPLOY.md "Monitoring"): the scheduler pings this URL
# every 5 minutes (/fail when the database, disk or Alpaca has a problem).
# Create a free check at https://healthchecks.io (period 5 min, grace 10 min)
# and paste its ping URL. Empty = no outside monitor.
# ---------------------------------------------------------------------------
HEALTHCHECK_PING_URL=

# ---------------------------------------------------------------------------
# Learning layer (arena/learning, LEARNING.md): 1-minute data, hourly risk
# checks, daily/weekly reviews, lessons, risk-adjusted scoring. All its
# thresholds are in config/learning.yaml. 0 = the league runs exactly as
# before. Run the dry run first (LEARNING.md "Going live").
# ---------------------------------------------------------------------------
LEARNING_ENABLED=0

# ---------------------------------------------------------------------------
# Alpaca paper mirror: off | leader | each | combined
# combined = one paper account, both agents' trades as labeled orders.
# ---------------------------------------------------------------------------
MIRROR_MODE=off
# How big the copied positions are: scaled | exact
# scaled = same percentages as the league, sized to the Alpaca account
# exact  = the league's own share counts, so Alpaca's dollar gains and losses
#          match the website (the rest of the account stays as cash)
MIRROR_SIZING=scaled
# ChatGPT's own paper account, for MIRROR_MODE=each
# ALPACA_MIRROR_GPT_KEY=
# ALPACA_MIRROR_GPT_SECRET=
# Claude's own paper account (optional; defaults to ALPACA_API_KEY / ALPACA_SECRET_KEY)
# ALPACA_MIRROR_CLAUDE_KEY=
# ALPACA_MIRROR_CLAUDE_SECRET=

# ---------------------------------------------------------------------------
# Only for running on your Windows PC (start.cmd); ignored on the server.
# ---------------------------------------------------------------------------
# 1 = the app starts the scheduler when it opens
AUTOSTART_SCHEDULER=0
# Older setting, replaced by MIRROR_MODE:
# MIRROR_PAPER=0
# Other sites allowed to call the API (normally none; never "*"):
# DASHBOARD_ORIGINS=
