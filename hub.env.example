# Agent Hub settings. Copy to hub.env on the server (chmod 600). See HUB.md.
# Not used by the league; the league's .env is never given to the hub.

HUB_REPO=danielratz123-hub/ai-trading-league
# Fine-grained token for that one repo: Contents, Issues, Pull requests = Read and write;
# Actions = Read. Do NOT give it "Workflows": then no agent change can touch .github/workflows.
HUB_GITHUB_TOKEN=

# Claude's login: run `claude setup-token` on your PC, paste the sk-ant-oat01-... token.
# (Codex and Gemini sign in once inside the container, see HUB.md.)
# Only if Gemini's subscription sign-in doesn't work for you: a free AI Studio key instead.
# GEMINI_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Optional
# HUB_MAX_ROUNDS=4
# HUB_AGENT_TIMEOUT=45
# HUB_REVIEW_TIMEOUT=40
# Telegram ("ready to merge" / "needs you"); can be the league's bot.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
